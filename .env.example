# App and server config
SPRING_APPLICATION_NAME=vpnservice
SERVER_PORT=6040
CORS_ALLOWED_ORIGINS=http://localhost:6080,http://localhost:8080,http://react-service
LOGGING_LEVEL=INFO

# DB config
SPRING_DATASOURCE_URL=jdbc:postgresql://vpn-db:5432/vpnservice
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vpnservice

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_DATABASE=postgresql
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Auth integration
AUTHSERVICE_INTEGRATION=true
JWT_PUBLIC_KEY=change-me
JWT_ISSUER=msinit-authservice

# WireGuard
WIREGUARD_IMAGE=lscr.io/linuxserver/wireguard:latest
VPN_HOST=vpn.example.com
VPN_PORT=51820
VPN_CLIENT_DNS=10.8.0.1
VPN_CLIENT_ALLOWED_IPS=10.8.0.0/24
VPN_ADDRESS_PREFIX=10.8.0
VPN_ROUTER_HOSTNAME=vpn-local
WIREGUARD_CONTROL_URL=http://wireguard:51821
WIREGUARD_CONTROL_TOKEN=change-me

# VPN router integrations
GATEWAYSERVICE_INTEGRATION=true
GATEWAY_SERVICE_URL=http://gateway-service:8080
EMAILSERVICE_INTEGRATION=true
EMAIL_SERVICE_URL=http://email-service:6005
FILESERVICE_INTEGRATION=true
FILE_SERVICE_URL=http://file-service:6010
VAULTSERVICE_INTEGRATION=true
VAULT_SERVICE_URL=http://vault-service:6020
TELEMETRYSERVICE_INTEGRATION=true
TELEMETRY_SERVICE_URL=http://telemetry-service:6050
REACTSERVICE_INTEGRATION=true
REACT_SERVICE_URL=http://react-service

# Encryption key
ENCRYPTION_KEY=change-me
SERVICE_HTTP_CONNECT_TIMEOUT=5000
SERVICE_HTTP_READ_TIMEOUT=10000
